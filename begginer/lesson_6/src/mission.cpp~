// ─────────────────────────────────────────────
//  mission_loop()  runs EVERY 2 SECONDS.
//  Read sensors, send data, save to SD card.
// ─────────────────────────────────────────────
void mission_loop() {
    // --- Read sensors ---
    float temp     = sensors.temperature();  // degrees Celsius
    float pressure = sensors.pressure();     // hPa (hectopascal)
    float humidity = sensors.humidity();     // percent

    // --- Print to monitor ---
    Serial.print("Temp: ");    Serial.print(temp);     Serial.println(" C");
    Serial.print("Pressure: ");Serial.print(pressure); Serial.println(" hPa");
    Serial.print("Humidity: ");Serial.print(humidity); Serial.println(" %");

    // --- Send over LoRa radio ---
    //radio.send(temp, pressure, humidity);

    // --- Save to SD card ---
    sd.log(temp, pressure, humidity);
}
